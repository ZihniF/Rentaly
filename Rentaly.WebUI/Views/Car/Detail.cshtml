@model Rentaly.EntityLayer.Entities.Car
@{ ViewData["Title"] = "Araç Detayı"; Layout = "~/Views/AdminLayout/Index.cshtml"; }
<div class="page-header"><div><h1 class="page-title">@Model.Brand?.BrandName @Model.Model?.ModelName</h1><p class="page-subtitle">@Model.PlateNumber araç kaydı</p></div><a asp-action="CarList" class="btn btn-light">Listeye dön</a></div>
<div class="form-card"><div class="row g-4"><div class="col-lg-5">@if(!string.IsNullOrWhiteSpace(Model.ImageUrl)){<img src="@Model.ImageUrl" alt="@Model.PlateNumber" class="img-fluid rounded" />}else{<div class="p-5 text-center bg-light rounded"><i class="fa-solid fa-car-side fa-4x"></i></div>}</div><div class="col-lg-7"><table class="table"><tbody><tr><th>Marka / Model</th><td>@Model.Brand?.BrandName @Model.Model?.ModelName</td></tr><tr><th>Kategori</th><td>@Model.Category?.CategoryName</td></tr><tr><th>Şube</th><td>@Model.Branch?.City — @Model.Branch?.BranchName</td></tr><tr><th>Plaka / VIN</th><td>@Model.PlateNumber / @Model.VIN</td></tr><tr><th>Yıl / KM</th><td>@Model.Year / @Model.Kilometer.ToString("N0") km</td></tr><tr><th>Yakıt</th><td>@Model.FuelType</td></tr><tr><th>Günlük fiyat</th><td>@Model.DailyPrice.ToString("N2") ₺</td></tr><tr><th>Durum</th><td>@(Model.IsActive && Model.IsAvailable ? "Müsait" : "Müsait değil")</td></tr></tbody></table><a asp-action="Edit" asp-route-id="@Model.CarId" class="btn btn-primary">Düzenle</a></div></div></div>
