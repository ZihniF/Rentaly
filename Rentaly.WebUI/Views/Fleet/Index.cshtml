@model Rentaly.WebUI.Models.FleetViewModel
@{ ViewData["Title"]="Araçlar"; }
<section class="subhero" style="background-image:linear-gradient(rgba(5,10,15,.72),rgba(5,10,15,.72)),url('/rentaly/images/background/subheader.jpg')"><div class="container"><span>Rentaly Filosu</span><h1>Size uygun aracı bulun</h1></div></section>
<section class="section container fleet-layout">
<aside class="filter-card"><h2>Filtrele</h2><form method="get"><label>Marka<select asp-for="Filter.BrandId"><option value="">Tümü</option>@foreach(var x in Model.Brands){<option value="@x.BrandId">@x.BrandName</option>}</select></label><label>Marka Model<select asp-for="Filter.ModelId"><option value="">Tümü</option>@foreach(var x in Model.Models){<option value="@x.CarModelId">@x.Brand?.BrandName @x.ModelName</option>}</select></label><label>Lokasyon<select asp-for="Filter.BranchId"><option value="">Tümü</option>@foreach(var x in Model.Branches){<option value="@x.BranchId">@x.City — @x.BranchName</option>}</select></label><div class="two"><label>Min. fiyat<input asp-for="Filter.MinPrice" type="number" min="0" /></label><label>Maks. fiyat<input asp-for="Filter.MaxPrice" type="number" min="0" /></label></div><label>Alış<input asp-for="Filter.PickupDate" type="datetime-local" /></label><label>İade<input asp-for="Filter.ReturnDate" type="datetime-local" /></label><button>Listeyi güncelle</button><a asp-action="Index" class="clear">Filtreleri temizle</a></form></aside>
<div><div class="fleet-result"><strong>@Model.Cars.Count araç</strong><span>kriterlerinizle eşleşiyor</span></div><div class="car-grid fleet-grid">@foreach(var car in Model.Cars){<article class="car-card"><div class="car-image"><img src="@(string.IsNullOrWhiteSpace(car.ImageUrl)?"/rentaly/images/cars-alt/toyota-rav.png":car.ImageUrl)" alt="@car.Brand?.BrandName @car.Model?.ModelName" /></div><div class="car-body"><small>@car.Branch?.City · @car.Category?.CategoryName</small><h3>@car.Brand?.BrandName @car.Model?.ModelName</h3><div class="specs"><span>@car.SeatCount kişi</span><span>@car.FuelType</span><span>@car.Year</span></div><div class="price"><strong>@car.DailyPrice.ToString("N0") ₺</strong><span>/ gün</span><a asp-controller="Booking" asp-action="Index" asp-route-carId="@car.CarId" asp-route-pickupDate="@Model.Filter.PickupDate" asp-route-returnDate="@Model.Filter.ReturnDate" asp-route-branchId="@Model.Filter.BranchId">Rezervasyon</a></div></div></article>}</div>@if(!Model.Cars.Any()){<div class="empty-public">Bu filtrelere uygun müsait araç bulunamadı.</div>}</div>
</section>
