<!DOCTYPE html>
<html lang="tr">
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentSection = Context.Request.Query["section"].ToString();
    var isHomeContentPage = string.Equals(currentController, "HomeContents", StringComparison.OrdinalIgnoreCase);
}
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RentCar Admin Panel</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/style.css" />
</head>
@await RenderSectionAsync("Styles", required: false)
<body>

    <aside class="sidebar" id="sidebar">
            <a asp-area="Admin" asp-controller="Rentals" asp-action="Index" class="sidebar-logo">
            <div class="logo-icon"><i class="fa-solid fa-car-side"></i></div>
            <div class="logo-text">
                <strong>RentCar</strong>
                <span>Admin Panel</span>
            </div>
        </a>

        <nav class="sidebar-nav" id="sidebarNav">
            <div class="menu-label">Ana Menü</div>
            <a asp-area="" asp-controller="AdminLayout" asp-action="Index" class="nav-link active">
                <span class="nav-icon"><i class="fa-solid fa-gauge-high"></i></span>
                <span class="link-text">Dashboard</span>
            </a>

            <div class="menu-label">Araç Yönetimi</div>
            <div class="has-submenu" id="vehicleMenu">
                <div class="nav-link" onclick="toggleSubmenu('vehicleSubmenu', 'vehicleMenu')">
                    <span class="nav-icon"><i class="fa-solid fa-cars"></i></span>
                    <span class="link-text">Araç Yönetimi</span>
                    <i class="fa-solid fa-chevron-right submenu-arrow ms-auto"></i>
                </div>
                <div class="submenu open" id="vehicleSubmenu">
                    <a asp-area="" asp-controller="Car" asp-action="CarList" class="nav-link">
                        <span class="nav-icon"><i class="fa-solid fa-list"></i></span>
                        <span class="link-text">Araç Listesi</span>
                    </a>
                    <a asp-area="" asp-controller="Car" asp-action="CreateCar" class="nav-link">
                        <span class="nav-icon"><i class="fa-solid fa-plus"></i></span>
                        <span class="link-text">Yeni Araç Ekle</span>
                    </a>
                    <a asp-area="" asp-controller="Brand" asp-action="BrandList" class="nav-link">
                        <span class="nav-icon"><i class="fa-solid fa-trademark"></i></span>
                        <span class="link-text">Marka Yönetimi</span>
                    </a>
                    <a asp-area="Admin" asp-controller="Category" asp-action="CategoryList" class="nav-link">
                        <span class="nav-icon"><i class="fa-solid fa-tags"></i></span>
                        <span class="link-text">Kategori Yönetimi</span>
                    </a>
                </div>
            </div>

            <div class="menu-label">Operasyon</div>
            <a asp-area="" asp-controller="Branch" asp-action="BranchList" class="nav-link">
                <span class="nav-icon"><i class="fa-solid fa-building"></i></span>
                <span class="link-text">Şube Yönetimi</span>
            </a>
            <a asp-area="" asp-controller="Customer" asp-action="CustomerList" class="nav-link">
                <span class="nav-icon"><i class="fa-solid fa-users"></i></span>
                <span class="link-text">Müşteri Yönetimi</span>
            </a>
            <a asp-area="Admin" asp-controller="Rentals" asp-action="Index" class="nav-link">
                <span class="nav-icon"><i class="fa-solid fa-calendar-check"></i></span>
                <span class="link-text">Rezervasyon Yönetimi</span>
            </a>
            <div class="has-submenu @(isHomeContentPage ? "open" : "")" id="homeContentMenu">
                <div class="nav-link @(isHomeContentPage ? "active" : "")" role="button" tabindex="0"
                     onclick="toggleSubmenu('homeContentSubmenu', 'homeContentMenu')"
                     onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleSubmenu('homeContentSubmenu','homeContentMenu')}">
                    <span class="nav-icon"><i class="fa-solid fa-layer-group"></i></span>
                    <span class="link-text">Ana Sayfa İçerikleri</span>
                    <i class="fa-solid fa-chevron-right submenu-arrow ms-auto"></i>
                </div>
                <div class="submenu @(isHomeContentPage ? "open" : "")" id="homeContentSubmenu">
                    <a asp-area="Admin" asp-controller="HomeContents" asp-action="Index" class="nav-link @(isHomeContentPage && string.IsNullOrEmpty(currentSection) ? "active" : "")"><span class="link-text">Genel Bakış</span></a>
                    <a asp-area="Admin" asp-controller="HomeContents" asp-action="Index" asp-route-section="Process" class="nav-link @(currentSection == "Process" ? "active" : "")"><span class="link-text">Process / İşleyiş</span></a>
                    <a asp-area="Admin" asp-controller="HomeContents" asp-action="Index" asp-route-section="Future" class="nav-link @(currentSection == "Future" ? "active" : "")"><span class="link-text">Our Future</span></a>
                    <a asp-area="Admin" asp-controller="HomeContents" asp-action="Index" asp-route-section="Statistic" class="nav-link @(currentSection == "Statistic" ? "active" : "")"><span class="link-text">İstatistikler / About</span></a>
                    <a asp-area="Admin" asp-controller="HomeContents" asp-action="Index" asp-route-section="Award" class="nav-link @(currentSection == "Award" ? "active" : "")"><span class="link-text">Ödüller</span></a>
                    <a asp-area="Admin" asp-controller="HomeContents" asp-action="Index" asp-route-section="Testimonial" class="nav-link @(currentSection == "Testimonial" ? "active" : "")"><span class="link-text">Testimonial</span></a>
                    <a asp-area="Admin" asp-controller="HomeContents" asp-action="Index" asp-route-section="Faq" class="nav-link @(currentSection == "Faq" ? "active" : "")"><span class="link-text">Sık Sorulan Sorular</span></a>
                </div>
            </div>
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-user">
                <img src="https://ui-avatars.com/api/?name=Admin+User&background=1a56db&color=fff&size=80" alt="Admin" />
                <div class="user-info">
                    <div class="user-name">Admin User</div>
                    <div class="user-role">Süper Yönetici</div>
                </div>
            </div>
        </div>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebarMobile()"></div>

    <div class="main-wrapper" id="mainWrapper">

        <nav class="navbar-top" id="navbarTop">
            <button class="toggle-btn" id="toggleBtn" onclick="toggleSidebar()">
                <i class="fa-solid fa-bars"></i>
            </button>
            <div class="navbar-breadcrumb d-none d-sm-block">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-area="" asp-controller="AdminLayout" asp-action="Index">Yönetim Paneli</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
            <div class="navbar-actions ms-auto">
                @await Component.InvokeAsync("AdminNotification")
                <button class="action-btn"><i class="fa-regular fa-envelope"></i></button>
                <div class="navbar-divider d-none d-sm-block"></div>
                <div class="dropdown admin-dropdown">
                    <button type="button" class="dropdown-toggle d-flex align-items-center gap-2 border-0 bg-transparent" data-bs-toggle="dropdown">
                        <img src="https://ui-avatars.com/api/?name=Admin+User&background=1a56db&color=fff&size=80" alt="Admin">
                        <div class="admin-info d-none d-lg-flex">
                            <span class="admin-name">Admin User</span><span class="admin-role">Süper Yönetici</span>
                        </div>
                        <i class="fa-solid fa-chevron-down" style="font-size:11px;color:var(--text-muted);"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Rentals" asp-action="Index"><i class="fa-solid fa-calendar-check"></i> Rezervasyonlar</a></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-arrow-up-right-from-square"></i> Siteyi Gör</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <main class="page-content">
            @RenderBody()
        </main>

        <footer class="site-footer">
            <div class="footer-text">© 2026 <span>RentCar</span> Yönetim Paneli — Tüm Hakları Saklıdır</div>
        </footer>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="/js/script.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
