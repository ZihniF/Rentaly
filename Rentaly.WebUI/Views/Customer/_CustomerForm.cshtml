@model dynamic
<div class="form-card" style="max-width:850px"><form method="post">@Html.AntiForgeryToken()@if(Model.CustomerId>0){<input name="CustomerId" value="@Model.CustomerId" type="hidden">}<div class="row g-3"><div class="col-md-6"><label class="form-label">Ad</label><input name="Name" value="@Model.Name" class="form-control" required></div><div class="col-md-6"><label class="form-label">Soyad</label><input name="Surname" value="@Model.Surname" class="form-control" required></div><div class="col-md-6"><label class="form-label">E-posta</label><input name="Email" value="@Model.Email" type="email" class="form-control" required></div><div class="col-md-6"><label class="form-label">Telefon</label><input name="Phone" value="@Model.Phone" class="form-control" required></div><div class="col-md-6"><label class="form-label">Kimlik No</label><input name="IdentityNumber" value="@Model.IdentityNumber" class="form-control"></div><div class="col-md-6"><label class="form-label">Ehliyet No</label><input name="DrivingLicenseNumber" value="@Model.DrivingLicenseNumber" class="form-control"></div><div class="col-md-6"><label class="form-label">Ehliyet tarihi</label><input name="DrivingLicenseDate" value="@Model.DrivingLicenseDate.ToString("yyyy-MM-dd")" type="date" class="form-control"></div></div><button class="btn btn-primary mt-4">Kaydet</button></form></div>
