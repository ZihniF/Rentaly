@model Rentaly.DtoLayer.CustomerDtos.GetCustomerByIdDto
@{ ViewData["Title"] = "Müşteri Detayı"; Layout = "~/Views/AdminLayout/Index.cshtml"; }
<div class="page-header"><div><h1 class="page-title">@Model.Name @Model.Surname</h1><p class="page-subtitle">Müşteri #@Model.CustomerId</p></div><a asp-action="CustomerList" class="btn btn-light">Listeye dön</a></div><div class="form-card" style="max-width:800px"><dl class="row"><dt class="col-sm-3">E-posta</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Telefon</dt><dd class="col-sm-9">@Model.Phone</dd><dt class="col-sm-3">T.C. kimlik no</dt><dd class="col-sm-9">@Model.IdentityNumber</dd><dt class="col-sm-3">Ehliyet</dt><dd class="col-sm-9">@Model.DrivingLicenseNumber — @Model.DrivingLicenseDate.ToString("dd.MM.yyyy")</dd></dl><a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary">Düzenle</a></div>
