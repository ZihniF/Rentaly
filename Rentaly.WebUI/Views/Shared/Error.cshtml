@model Rentaly.DtoLayer.PageDtos.ErrorPageDto
@{
    ViewData["Title"] = "Hata";
}

<h1 class="text-danger">Bir hata oluştu.</h1>
<p>İşleminiz tamamlanırken beklenmeyen bir sorun oluştu. Lütfen yeniden deneyin.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>İstek kodu:</strong> <code>@Model.RequestId</code>
    </p>
}
