<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Rentaly</title>
    <link rel="icon" href="~/rentaly/images/icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/rentaly/css/plugins.css" />
    <link rel="stylesheet" href="~/css/rentaly-public.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/booking-ocr.css" asp-append-version="true" />
</head>
<body>
<header class="public-header">
    <div class="container header-inner">
        <a asp-controller="Home" asp-action="Index" class="brand"><img src="~/rentaly/images/logo.png" alt="Rentaly" /></a>
        <nav>
            <a asp-controller="Home" asp-action="Index">Ana Sayfa</a>
            <a asp-controller="Home" asp-action="Index" asp-fragment="process">İşleyiş</a>
            <a asp-controller="Fleet" asp-action="Index">Araçlar</a>
            <a asp-controller="Home" asp-action="Index" asp-fragment="faq">FAQ</a>
        </nav>
    </div>
</header>
<main>@RenderBody()</main>
<footer class="public-footer">
    <div class="container footer-grid"><div><img src="~/rentaly/images/logo-light.png" alt="Rentaly" /><p>Kaliteli araçlar, kolay rezervasyon ve güvenli yolculuk.</p></div><div><strong>İletişim</strong><p>+90 850 000 00 00<br />hello@rentaly.com</p></div><div><strong>Çalışma saatleri</strong><p>Hafta içi 08.00–18.00<br />7/24 yol yardım</p></div></div>
    <div class="container copyright">© @DateTime.Now.Year Rentaly — Tüm hakları saklıdır.</div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
