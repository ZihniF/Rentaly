@model Rentaly.EntityLayer.Entities.Branch
@{
    ViewData["Title"] = "Şube Düzenle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-header">
    <h1 class="page-title">Şube Düzenle</h1>
</div>

<div class="form-card" style="max-width:700px">
    <form asp-action="Edit" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="BranchId" type="hidden" />
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="BranchName" class="form-label">Şube adı</label>
            <input asp-for="BranchName" class="form-control" />
            <span asp-validation-for="BranchName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="City" class="form-label">Şehir</label>
            <input asp-for="City" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Address" class="form-label">Adres</label>
            <textarea asp-for="Address" class="form-control"></textarea>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
        <a asp-action="BranchList" class="btn btn-outline-secondary">Vazgeç</a>
    </form>
</div>
