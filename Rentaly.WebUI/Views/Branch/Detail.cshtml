@model Rentaly.EntityLayer.Entities.Branch
@{ ViewData["Title"] = "Şube Detayı"; Layout = "~/Views/AdminLayout/Index.cshtml"; }
<div class="page-header"><div><h1 class="page-title">@Model.BranchName</h1><p class="page-subtitle">Şube detayı</p></div><a asp-action="BranchList" class="btn btn-light">Listeye dön</a></div><div class="form-card" style="max-width:800px"><dl class="row"><dt class="col-sm-3">Şehir</dt><dd class="col-sm-9">@Model.City</dd><dt class="col-sm-3">Adres</dt><dd class="col-sm-9">@Model.Address</dd></dl><a asp-action="Edit" asp-route-id="@Model.BranchId" class="btn btn-primary">Düzenle</a></div>
