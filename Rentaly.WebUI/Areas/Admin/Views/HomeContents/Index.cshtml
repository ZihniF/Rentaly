@model Rentaly.DtoLayer.PageDtos.HomeContentsIndexDto
@using Rentaly.WebUI.Models
@{
    ViewData["Title"] = "Ana Sayfa İçerikleri";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    var selectedDefinition = Model.SelectedSection.HasValue
        ? HomeSectionCatalog.All.First(x => x.Section == Model.SelectedSection.Value)
        : null;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title">@(selectedDefinition?.Name ?? "Ana Sayfa İçerikleri")</h1>
        <p class="page-subtitle">@(selectedDefinition?.Description ?? "Frontend ana sayfasındaki tüm dinamik bölümleri buradan yönetin.")</p>
    </div>
    <a asp-action="Create" asp-route-section="@Model.SelectedSection" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Yeni içerik</a>
</div>

@if (TempData["Success"] is not null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] is not null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="row g-3 mb-4">
    @foreach (var definition in HomeSectionCatalog.All)
    {
        <div class="col-md-6 col-xl-4">
            <a asp-action="Index" asp-route-section="@definition.Section" class="text-decoration-none">
                <div class="table-card p-3 h-100 @(Model.SelectedSection == definition.Section ? "border border-primary" : "")">
                    <div class="d-flex align-items-start gap-3">
                        <span class="btn btn-sm btn-light"><i class="fa-solid @definition.Icon"></i></span>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between gap-2"><strong>@definition.Name</strong><span class="badge bg-primary">@Model.Count(definition.Section)</span></div>
                            <small class="text-muted">@definition.Description</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

<div class="table-card">
    <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
        <div>
            <strong>@(selectedDefinition?.Name ?? "Tüm dinamik bölümler")</strong>
            <div class="text-muted small">@Model.Items.Count kayıt gösteriliyor.</div>
        </div>
        @if (Model.SelectedSection.HasValue)
        {
            <a asp-action="Index" class="btn btn-sm btn-light">Tümünü göster</a>
        }
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Sıra</th><th>Bölüm</th><th>Başlık / İçerik</th><th>Durum</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.DisplayOrder</td>
                        <td><span class="badge bg-light text-dark">@item.Section.DisplayName()</span></td>
                        <td><strong>@item.Title</strong>@if (!string.IsNullOrWhiteSpace(item.Subtitle)) { <br /><small>@item.Subtitle</small> }</td>
                        <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Yayında" : "Pasif")</span></td>
                        <td>
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-action="Details" asp-route-id="@item.HomeContentId" asp-route-section="@item.Section" class="btn btn-sm btn-outline-secondary"><i class="fa-regular fa-eye"></i> Görüntüle</a>
                                <a asp-action="Edit" asp-route-id="@item.HomeContentId" asp-route-section="@item.Section" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                <form asp-action="Delete" asp-route-id="@item.HomeContentId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bu içerik kalıcı olarak silinsin mi?')">Sil</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">Bu bölümde henüz içerik bulunmuyor.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
